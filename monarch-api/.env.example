# --- Server ---
PORT=4000
# PostgreSQL required (local: Docker/Neon/Supabase; Render/Neon for production)
# Example: postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/monarch?schema=public"

# --- Auth (required) ---
# Generate a long random string for production (e.g. openssl rand -hex 32)
JWT_SECRET="change-me-min-8-chars"

# --- CORS + SIWE (must match how you open the frontend) ---
# Comma-separated for multiple deploys (e.g. Vercel + local Vite). Non-production servers also allow localhost:8080 automatically.
FRONTEND_ORIGIN="http://localhost:8080"
SIWE_DOMAIN="localhost"
SIWE_ORIGIN="http://localhost:8080"

# --- Chain (optional but recommended) ---
# JSON-RPC URL for Sepolia (Alchemy, Infura, etc.) — required for on-chain buy/sell settlement.
# Must be reachable from this machine (firewall/VPN). If the URL is wrong or times out, the API may log RPC errors.
SEPOLIA_RPC_URL=""
# Hex private key with 0x prefix — relayer/minter wallet only (must hold MINTER_ROLE on AssetToken; not your browser wallet).
# Using the same account as MetaMask causes nonce / "replacement fee too low" conflicts. Use a dedicated funded key.
# When set with SEPOLIA_RPC_URL, GET /config reports chainSettlementEnabled and buys require a USDC transfer + relayer mint.
PRIVATE_KEY=""

# Secondary settlement pool: RWA **sells** send tokens here; relayer pays seller mock USDC. Prefer this over legacy TREASURY_ADDRESS.
SECONDARY_TREASURY_ADDRESS=""
# Deprecated alias for SECONDARY_TREASURY_ADDRESS (still read if SECONDARY_TREASURY_ADDRESS is unset).
TREASURY_ADDRESS=""
# Primary / catalog payout (issuer wallet): prisma seed sets escrowBeneficiary on demo assets here — not the sell pool.
PRIMARY_ISSUER_ADDRESS=""
# Optional: multisig shown in GET /config only.
TREASURY_SAFE_ADDRESS=""
# Optional MilestoneEscrow address — also paste into asset row in DB / seed for escrow-funded primary buys.
MILESTONE_ESCROW_ADDRESS=""
# stub (default): anyone can list; strict: lister must have User.kycStatus APPROVED.
KYC_MODE="stub"

# --- Contracts (paste from monarch-contracts/deployed-addresses.json after deploy) ---
MOCK_USDC_ADDRESS=""
ASSET_REGISTRY_ADDRESS=""
PAYOUT_DISTRIBUTOR_ADDRESS=""

# --- OpenAI (optional — risk scoring falls back if empty) ---
OPENAI_API_KEY=""

# Auto-publish new listings to marketplace (default true). Set false to use admin approval only.
LISTINGS_AUTO_PUBLISH=true
