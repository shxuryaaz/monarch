# Backend API (monarch-api default port)
VITE_API_BASE_URL=http://localhost:4000

# Sepolia JSON-RPC for the browser (wallet / viem). Required for reliable txs — public RPCs rate-limit
# and cause "RPC endpoint returned too many errors". Use the same URL as monarch-api SEPOLIA_RPC_URL.
# VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Optional second URL if the primary is down (otherwise only VITE_SEPOLIA_RPC_URL is used).
# VITE_SEPOLIA_RPC_FALLBACK_URL=https://...

# Optional overrides (defaults match monarch-contracts/deployed-addresses.json sample deploy)
# VITE_MOCK_USDC_ADDRESS=0x...
# VITE_PAYOUT_DISTRIBUTOR_ADDRESS=0x...
# Secondary pool for sells (optional; GET /config is authoritative when app loads).
# VITE_SECONDARY_TREASURY_ADDRESS=0x...
# Legacy alias:
# VITE_TREASURY_ADDRESS=0x...
