# Backend API (Render/production: your API origin, no trailing slash)
VITE_API_BASE_URL=http://localhost:4000

# Sepolia HTTPS RPC — required for reliable production builds (Vite inlines at build time).
# On Vercel: Project → Settings → Environment Variables → Production → add VITE_SEPOLIA_RPC_URL, then Redeploy.
# Alchemy/Infura strongly recommended; the app also falls back to public RPCs for viem, but MetaMask still uses the RPC saved in the wallet for sends.
# VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Optional overrides (defaults match monarch-contracts/deployed-addresses.json sample deploy)
# VITE_MOCK_USDC_ADDRESS=0x...
# VITE_PAYOUT_DISTRIBUTOR_ADDRESS=0x...
# Secondary pool for sells (optional; GET /config is authoritative when app loads).
# VITE_SECONDARY_TREASURY_ADDRESS=0x...
# Legacy alias:
# VITE_TREASURY_ADDRESS=0x...
